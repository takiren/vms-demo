# 暗号化キー (32-byte base64; openssl rand -base64 32 で生成)
VMS_SECRET_KEY=CHANGE_ME

# PostgreSQL データベース設定
POSTGRES_USER=vms
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=vms
DATABASE_URL=postgres://vms:CHANGE_ME@localhost:5432/vms?sslmode=disable

# Garage オブジェクトストレージ設定
# RPC シークレット (openssl rand -hex 32 で生成)
GARAGE_RPC_SECRET=CHANGE_ME
GARAGE_ADMIN_TOKEN=CHANGE_ME

# S3 互換ストレージアクセスキー (Garage key fixed via .env; Garage key ids look like GK + 24 hex)
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_ENDPOINT=https://s3.vms.localhost
S3_BUCKET=recordings

# アプリケーション設定
VMS_HOST=vms.localhost
VMS_ADMIN_USERNAME=admin
VMS_ADMIN_PASSWORD=CHANGE_ME
